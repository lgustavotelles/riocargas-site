# WordPress core (instalado pela imagem Docker / servidor)
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
!/wordpress/wp-content/plugins/
!/wordpress/wp-content/mu-plugins/

# Plugins e temas sao runtime do servidor (reinstalaveis via WP.org).
# Excecao: vverner (child theme proprio, historico) fica versionado.
/wordpress/wp-content/plugins/*
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/vverner/

# Mídia e caches
/wordpress/wp-content/uploads/
/wordpress/wp-content/cache/
/wordpress/wp-content/upgrade/

# Backups, dumps e segredos
/dumps/*
!/dumps/.gitkeep
*.sql
*.sql.gz
*.zip
*.tar.gz
.env
wp-config.php
error_log
debug.log

# Artefatos locais de validacao visual (screenshots, HTML capturado)
/.shots/

# Pacotes de deploy gerados localmente
/dist/
